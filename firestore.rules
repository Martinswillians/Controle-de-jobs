rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "w9XSwxwewTaXwk0hCpyOuvCcd7G3";
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── Lista compartilhada de profissões ──
    // Leitura pública (a tela de cadastro precisa listar antes do login).
    // Qualquer usuário logado pode ADICIONAR uma profissão nova; só o admin edita/apaga.
    match /professions/{profId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'createdBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60;
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      // Próprio usuário lê seu perfil; admin também lê (para aprovar/bloquear)
      allow read: if isOwner(userId) || isAdmin();

      // Admin pode tudo (aprovar/bloquear usuários)
      allow write: if isAdmin();

      // Usuário comum: cria o próprio perfil SEM se auto-aprovar...
      allow create: if isOwner(userId) && !('accessStatus' in request.resource.data);

      // ...e edita o perfil sem mexer em accessStatus, createdAt e email
      // (antes, qualquer usuário conseguia se aprovar ou "renovar" o demo pelo console)
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessStatus', 'createdAt', 'email']);

      match /jobs/{jobId} {
        allow read, write: if isOwner(userId);
      }

      match /clients/{clientId} {
        allow read, write: if isOwner(userId);
      }

      match /deleteLogs/{logId} {
        // Logs antigos de exclusão: append-only
        allow read, create: if isOwner(userId);
      }

      match /activityLogs/{logId} {
        // Histórico de inclusões, alterações e exclusões: append-only
        // (pode ser criado e lido, nunca editado ou apagado, nem pelo dono)
        allow read, create: if isOwner(userId);
      }
    }
  }
}
